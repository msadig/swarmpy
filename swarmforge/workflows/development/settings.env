# Workflow settings for: development
# This file is sourced before each agent starts.
# Keep secrets out of this file unless you intentionally want them in the repo.

SWARMPY_DEV_PROJECT_NAME=swarmpy
SWARMPY_DEV_TEST_COMMAND="uv run --script test.py"
SWARMPY_DEV_SYNTAX_COMMAND="python3 -m py_compile swarm.py test.py"
SWARMPY_DEV_SOURCE_FILES="swarm.py test.py README.md SKILL.md"
SWARMPY_DEV_CONTEXT_DIR="agent_context/development"

# Standard sprint intake settings.
GITHUB_TODO_LABEL="todo"
SWARMPY_PLAN_FILE="agent_context/development/sprint-plan.md"
SWARMPY_PLAN_REVIEW_FILE="agent_context/development/plan-review.md"
SWARMPY_IMPLEMENTATION_NOTES_FILE="agent_context/development/coder-notes.md"
SWARMPY_TEST_REPORT_FILE="agent_context/development/test-report.md"
SWARMPY_FINAL_REVIEW_FILE="agent_context/development/review.md"
